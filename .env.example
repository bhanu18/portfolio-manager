# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/portfolio_db
SYNC_DATABASE_URL=postgresql://user:password@localhost:5432/portfolio_db

# Security Configuration
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email Configuration (SMTP)
# For Gmail: Use smtp.gmail.com with port 587
# Note: For Gmail, you need to use an "App Password" instead of your regular password
# Generate one at: https://myaccount.google.com/apppasswords

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=Portfolio Tracker

# Alternative SMTP Providers:
# Outlook: smtp-mail.outlook.com, port 587
# Yahoo: smtp.mail.yahoo.com, port 587
# SendGrid: smtp.sendgrid.net, port 587 (use API key as password)

# Testing Database (required for running tests)
TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/portfolio_db_test

# ===========================================
# Express Tailoring Appointment System Notes
# ===========================================
# The appointment booking system uses the same SMTP settings above.
# Business details (name, address, phone) are configured in:
#   service/appointment.py - BUSINESS_NAME, BUSINESS_ADDRESS, BUSINESS_PHONE
#
# Timezone: Asia/Bangkok (hardcoded for Paul Bespoke Suits)
# Business hours: 10:00 AM - 7:00 PM
# Booking window: Today to 90 days in advance
