# ---- Database (MySQL) ----
# Async URL used by the app, sync URL used by Alembic
DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/portfolio_db
SYNC_DATABASE_URL=mysql+pymysql://user:password@localhost:3306/portfolio_db
# Only needed for pytest
TEST_DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/portfolio_test
# Log every SQL statement (true/false)
DB_ECHO=false
# Special characters in passwords must be URL-encoded, e.g.:
#   python3 -c "import urllib.parse; print(urllib.parse.quote_plus('p@ss'))"

# ---- Security ----
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# ---- CORS ----
# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173

# ---- Frontend ----
# Base URL for links in emails (password reset)
FRONTEND_URL=http://localhost:5173

# ---- Email (SMTP) ----
# Gmail needs an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=Portfolio Manager

# ---- Private research desk ----
# Server-side key only; never put this in VITE_* or commit a real key.
OPENAI_API_KEY=
RESEARCH_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_RESEARCH_MODEL=claude-sonnet-5-5
# openai | anthropic | local | auto (auto routes each step to the cheapest capable model)
RESEARCH_PROVIDER=openai
# Local models via an OpenAI-compatible API (Ollama: `ollama pull qwen3:8b`).
# Leave LOCAL_LLM_MODEL empty to disable. Raise OLLAMA_CONTEXT_LENGTH (>= 16384) for research prompts.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=
# Maps columns of non-standard trade imports (empty = LOCAL_LLM_MODEL; 4B+ instruct recommended)
IMPORT_LLM_MODEL=
LOCAL_LLM_API_KEY=ollama
# Let thinking models (Gemma 4, Qwen3) reason before answering: better, much slower.
LOCAL_LLM_THINKING=false
# Auto orchestrator tiers as provider:model (local tier = LOCAL_LLM_MODEL)
RESEARCH_TIER_CHEAP=openai:gpt-5-mini
RESEARCH_TIER_STRONG=anthropic:claude-sonnet-5-5
RESEARCH_DAILY_LIMIT=20
RESEARCH_MAX_ACTIVE_PER_USER=1
RESEARCH_MAX_MODEL_TURNS=6
RESEARCH_MAX_TOOL_CALLS=8
RESEARCH_TIMEOUT_SECONDS=180
RESEARCH_MAX_INPUT_TOKENS=24000
RESEARCH_MAX_OUTPUT_TOKENS=12000
RESEARCH_LEASE_SECONDS=30
RESEARCH_POLL_SECONDS=2

# --- LangSmith tracing + evals (research worker and backend/evals) ---
# Off by default: traces include user questions and reports. Needs a key from smith.langchain.com.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=portfolio-research
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false
